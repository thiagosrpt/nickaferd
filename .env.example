# Copy to `.env.local` and fill values
# YouTube Data API v3 key and the channel id to pull latest videos
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# TikTok username (no @)
TIKTOK_USERNAME=nickaferd

# Optional: base URL used when running behind a proxy or in environments
# e.g. NEXT_PUBLIC_BASE_URL=https://my-site.example.com
NEXT_PUBLIC_BASE_URL=
